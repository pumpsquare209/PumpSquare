# Pumpsquare Backend Environment Variables

# Server
PORT=4000
NODE_ENV=production

# Sarvam AI (Chatbot)
# Get from https://sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Frontend Origin(s)
# Must be exact origin(s), no trailing slash
# Primary origin (required):
# Example: https://pumpsquare.vercel.app
FRONTEND_ORIGIN=
# Additional origins (optional, comma-separated, for preview deployments):
# Example: https://pumpsquare-git-main.vercel.app,https://pumpsquare-git-feature.vercel.app
FRONTEND_ORIGINS=

# Chat Configuration
CHAT_MAX_HISTORY=12
CHAT_RATE_LIMIT=10

# Supabase (ALL CREDENTIALS IN BACKEND ONLY)
# Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret for admin sessions (generate a strong random string)
# Use: openssl rand -base64 32
# Must be at least 32 characters
JWT_SECRET=