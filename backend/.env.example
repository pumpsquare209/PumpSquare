# Pumpsquare Backend Environment Variables

# Server
PORT=4000
NODE_ENV=production

# Sarvam AI (Chatbot)
# Get from https://sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Frontend Origin (Vercel deployment URL)
# Must be exact origin, no trailing slash
# Example: https://pumpsquare.vercel.app
FRONTEND_ORIGIN=

# Chat Configuration
CHAT_MAX_HISTORY=12
CHAT_RATE_LIMIT=10

# Supabase (ALL CREDENTIALS IN BACKEND ONLY)
# Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret for admin sessions (generate a strong random string)
# Use: openssl rand -base64 32
JWT_SECRET=